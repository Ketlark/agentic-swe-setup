{
  "name": "@ketlark/docs-proxy",
  "version": "1.0.0",
  "description": "Single-tool MCP proxy that fetches documentation from GitHub repos, direct URLs, or a built-in library-name map.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "docs-proxy": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  }
}
